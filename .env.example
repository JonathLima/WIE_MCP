# SearxNG configuration
SEARXNG_HOST=http://searxng:8080
# Broad source coverage: general + news + science + social + forums + code.
# Any engine listed here must also be enabled (disabled: false) in searxng/settings.yml.
SEARXNG_ENGINES=google,bing,duckduckgo,brave,qwant,mojeek,sepiasearch,mwmbl,wikipedia,wikidata,google news,bing news,duckduckgo news,reuters,arxiv,semantic scholar,crossref,openalex,europepmc,lemmy posts,lemmy comments,mastodon hashtags,hackernews,github
SEARXNG_DEFAULT_CATEGORY=general
SEARXNG_SAFESEARCH=0
SEARXNG_SECRET=change-me-to-a-random-string

# MCP Server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000

# Optional API key for MCP server protection (leave empty to disable)
API_KEY=

# Search settings
SEARCH_DEFAULT_TYPE=auto  # instant, fast, auto, deep_lite, deep, deep_reasoning
SEARCH_DEFAULT_LIMIT=10
SEARCH_TIMEOUT_SECONDS=10

# Fetcher settings
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_CONTENT_LENGTH=10000
FETCH_TOKEN_BUDGET=8000
FETCH_GLOBAL_TIMEOUT=45
FETCH_RATE_LIMIT_COOLDOWN=2

# Obscura stealth browser (Rust, TLS impersonation) — anti-bot fallback tier
OBSCURA_ENABLED=true
OBSCURA_STEALTH=true
OBSCURA_TIMEOUT_SECONDS=20
# OBSCURA_BINARY=/usr/local/bin/obscura   # override only if installed elsewhere
# OBSCURA_PROXY=                          # optional: http:// or socks5:// proxy for egress
